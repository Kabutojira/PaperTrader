    "@types/yargs": "17.0.35",
    "prettier": "3.9.6",
    "typescript": "5.9.2",
    "@quartz-community/types": "1.0.0",
    "@quartz-community/utils": "1.0.0",
    "esbuild": "0.28.2",
    "tsx": "4.21.0"
