    "check": "npm run prepare-engine && tsc --noEmit && prettier quartz.config.ts quartz.layout.ts papertrader prepare-quartz.mjs build-quartz.mjs quartz.ts index.d.ts globals.d.ts --check"
  },
  "dependencies": {
