{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kabutojira/PaperTrader/schemas/decision_snapshot.schema.json",
  "title": "PaperTrader deterministic decision snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "snapshot_id",
    "run_id",
    "as_of",
    "report_date",
    "stance",
    "stance_reason_codes",
    "base_currency",
    "current_portfolio",
    "actionable_signals",
    "candidate_pipeline",
    "research_alerts",
    "coverage",
    "performance",
    "system_impacts",
    "source_state_hashes"
  ],
  "properties": {
    "version": { "enum": [1, 2, 3, 4, 5] },
    "snapshot_id": { "type": "string", "pattern": "^decision_[0-9a-f]{20}$" },
    "run_id": { "$ref": "#/$defs/runId" },
    "as_of": { "$ref": "#/$defs/timestamp" },
    "report_date": { "type": "string", "format": "date" },
    "data_status": { "enum": ["current", "degraded", "blocked"] },
    "investment_data_status": { "enum": ["current", "degraded", "blocked"] },
    "operations_status": { "enum": ["current", "degraded", "blocked"] },
    "stance": {
      "enum": ["hold_cash", "maintain", "deploy", "rebalance", "reduce_risk", "exit", "blocked"]
    },
    "stance_reason_codes": { "$ref": "#/$defs/reasonCodes" },
    "evidence_state": { "enum": ["definitive_cash_preference", "provisional_cash_research_incomplete", "provisional_cash_valuation_unsupported", "provisional_cash_strategy_pending", "portfolio_blocked", "invested_or_actionable"] },
    "base_currency": { "$ref": "#/$defs/currency" },
    "current_portfolio": { "$ref": "#/$defs/portfolioSummary" },
    "approved_target_portfolio": { "$ref": "#/$defs/portfolioSummary" },
    "target_portfolio": { "$ref": "#/$defs/portfolioSummary" },
    "actionable_signals": {
      "type": "array",
      "items": { "$ref": "#/$defs/actionableSignal" }
    },
    "candidate_pipeline": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "research_benchmark": { "$ref": "#/$defs/researchBenchmark" },
    "research_alerts": {
      "type": "array",
      "items": { "$ref": "#/$defs/researchAlert" }
    },
    "coverage": { "$ref": "#/$defs/coverage" },
    "performance": { "$ref": "#/$defs/performance" },
    "system_impacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/systemImpact" }
    },
    "source_state_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "version": { "const": 1 } },
        "required": ["version"]
      },
      "then": {
        "required": ["data_status", "approved_target_portfolio"],
        "properties": {
          "coverage": {
            "required": ["current_relationship_count", "required_relationship_count"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "version": { "const": 2 } },
        "required": ["version"]
      },
      "then": {
        "required": ["investment_data_status", "operations_status", "approved_target_portfolio"],
        "properties": {
          "coverage": {
            "required": [
              "reviewed_relationship_count",
              "accepted_relationship_count",
              "required_relationship_review_count"
            ]
          },
          "performance": {
            "required": [
              "performance_epoch_id",
              "epoch_started_at",
              "epoch_opening_equity_base",
              "prior_epoch_count"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "version": { "const": 3 } },
        "required": ["version"]
      },
      "then": {
        "required": ["investment_data_status", "operations_status", "evidence_state", "research_benchmark", "approved_target_portfolio"],
        "properties": {
          "current_portfolio": {
            "properties": {
              "rows": {
                "items": {
                  "required": ["bear_fair_value", "bear_return_pct", "bear_probability_pct", "base_fair_value", "base_return_pct", "base_probability_pct", "bull_fair_value", "bull_return_pct", "bull_probability_pct", "expected_return_pct", "confidence_adjusted_expected_return_pct", "buy_below_price", "canonical_rating", "portfolio_action", "evidence_state", "rating_change_conditions"]
                }
              }
            }
          },
          "approved_target_portfolio": {
            "properties": {
              "rows": {
                "items": {
                  "required": ["bear_fair_value", "bear_return_pct", "bear_probability_pct", "base_fair_value", "base_return_pct", "base_probability_pct", "bull_fair_value", "bull_return_pct", "bull_probability_pct", "expected_return_pct", "confidence_adjusted_expected_return_pct", "buy_below_price", "canonical_rating", "portfolio_action", "evidence_state", "rating_change_conditions"]
                }
              }
            }
          },
          "candidate_pipeline": {
            "items": {
              "required": ["bear_fair_value", "bear_return_pct", "bear_probability_pct", "base_fair_value", "base_return_pct", "base_probability_pct", "bull_fair_value", "bull_return_pct", "bull_probability_pct", "expected_return_pct", "confidence_adjusted_expected_return_pct", "buy_below_price", "canonical_rating", "portfolio_action", "evidence_state", "eligibility_frontier", "rating_change_conditions", "research_conclusion"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "version": { "const": 4 } },
        "required": ["version"]
      },
      "then": {
        "required": ["investment_data_status", "operations_status", "evidence_state", "research_benchmark", "target_portfolio"],
        "not": { "required": ["approved_target_portfolio"] },
        "properties": {
          "current_portfolio": {
            "properties": {
              "rows": {
                "items": {
                  "required": ["bear_fair_value", "bear_return_pct", "bear_probability_pct", "base_fair_value", "base_return_pct", "base_probability_pct", "bull_fair_value", "bull_return_pct", "bull_probability_pct", "expected_return_pct", "confidence_adjusted_expected_return_pct", "buy_below_price", "canonical_rating", "portfolio_action", "evidence_state", "rating_change_conditions"]
                }
              }
            }
          },
          "target_portfolio": {
            "properties": {
              "rows": {
                "items": {
                  "required": ["bear_fair_value", "bear_return_pct", "bear_probability_pct", "base_fair_value", "base_return_pct", "base_probability_pct", "bull_fair_value", "bull_return_pct", "bull_probability_pct", "expected_return_pct", "confidence_adjusted_expected_return_pct", "buy_below_price", "canonical_rating", "portfolio_action", "evidence_state", "rating_change_conditions"]
                }
              }
            }
          },
          "candidate_pipeline": {
            "items": {
              "required": ["bear_fair_value", "bear_return_pct", "bear_probability_pct", "base_fair_value", "base_return_pct", "base_probability_pct", "bull_fair_value", "bull_return_pct", "bull_probability_pct", "expected_return_pct", "confidence_adjusted_expected_return_pct", "buy_below_price", "canonical_rating", "portfolio_action", "evidence_state", "eligibility_frontier", "rating_change_conditions", "research_conclusion"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "version": { "const": 5 } },
        "required": ["version"]
      },
      "then": {
        "required": ["investment_data_status", "operations_status", "evidence_state", "research_benchmark", "target_portfolio"],
        "not": { "required": ["approved_target_portfolio"] },
        "properties": {
          "current_portfolio": { "properties": { "rows": { "items": { "required": ["tier", "allocation_intent_id", "assessment_id", "valuation_mark", "valuation_mark_currency", "valuation_mark_as_of", "position_cap_pct", "margin_of_safety_pct", "bear_base_payoff_ratio", "expected_bear_payoff_ratio"] } } } },
          "target_portfolio": { "properties": { "rows": { "items": { "required": ["tier", "allocation_intent_id", "assessment_id", "valuation_mark", "valuation_mark_currency", "valuation_mark_as_of", "position_cap_pct", "margin_of_safety_pct", "bear_base_payoff_ratio", "expected_bear_payoff_ratio"] } } } },
          "candidate_pipeline": { "items": { "required": ["tier", "allocation_intent_id", "assessment_id", "valuation_mark", "valuation_mark_currency", "valuation_mark_as_of", "position_cap_pct", "target_quantity", "margin_of_safety_pct", "bear_base_payoff_ratio", "expected_bear_payoff_ratio"] } },
          "actionable_signals": { "items": { "required": ["allocation_intent_id"] } }
        }
      }
    }
  ],
  "$defs": {
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "decimal": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "reasonCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "modelPortfolioRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id", "as_of", "holding_type", "security_id", "ticker", "company_name",
        "instrument_type", "sleeve", "current_weight_pct",
        "current_value_base", "delta_value_base",
        "current_quantity", "mark", "mark_currency",
        "fx_rate_to_base", "market_data_as_of", "action", "action_status", "strategy_id",
        "signal_id", "order_id", "confidence", "effective_score", "downside_pct",
        "base_upside_pct", "valuation_horizon_months", "thesis_summary", "entry_rule",
        "exit_rule", "invalidation", "review_at", "research_page", "reason_codes"
      ],
      "oneOf": [
        {
          "required": ["approved_target_weight_pct", "approved_target_value_base", "approved_target_quantity"],
          "not": { "anyOf": [{ "required": ["target_weight_pct"] }, { "required": ["target_value_base"] }, { "required": ["target_quantity"] }] }
        },
        {
          "required": ["target_weight_pct", "target_value_base", "target_quantity"],
          "not": { "anyOf": [{ "required": ["approved_target_weight_pct"] }, { "required": ["approved_target_value_base"] }, { "required": ["approved_target_quantity"] }] }
        }
      ],
      "properties": {
        "snapshot_id": { "type": "string" },
        "as_of": { "$ref": "#/$defs/timestamp" },
        "holding_type": { "enum": ["cash", "security"] },
        "security_id": { "type": "string" },
        "ticker": { "type": "string" },
        "company_name": { "type": "string" },
        "instrument_type": { "type": "string" },
        "sleeve": { "type": "string" },
        "tier": { "enum": ["", "full", "starter", "watch"] },
        "allocation_intent_id": { "type": "string" },
        "assessment_id": { "type": "string" },
        "current_weight_pct": { "$ref": "#/$defs/decimal" },
        "approved_target_weight_pct": { "$ref": "#/$defs/decimal" },
        "target_weight_pct": { "$ref": "#/$defs/decimal" },
        "current_value_base": { "$ref": "#/$defs/decimal" },
        "approved_target_value_base": { "$ref": "#/$defs/decimal" },
        "target_value_base": { "$ref": "#/$defs/decimal" },
        "delta_value_base": { "$ref": "#/$defs/decimal" },
        "current_quantity": { "$ref": "#/$defs/decimal" },
        "approved_target_quantity": { "$ref": "#/$defs/decimal" },
        "target_quantity": { "$ref": "#/$defs/decimal" },
        "mark": { "type": "string" },
        "mark_currency": { "type": "string" },
        "mark_base": { "type": "string" },
        "fx_rate_to_base": { "type": "string" },
        "fx_as_of": { "type": "string" },
        "market_data_as_of": { "type": "string" },
        "valuation_mark": { "type": "string" },
        "valuation_mark_currency": { "type": "string" },
        "valuation_mark_as_of": { "type": "string" },
        "position_cap_pct": { "type": "string" },
        "action": { "enum": ["buy", "add", "hold", "trim", "exit", "no_trade"] },
        "action_status": {
          "enum": ["filled", "pending_order", "active_signal", "awaiting_order_validation", "research_candidate", "blocked", "no_action"]
        },
        "strategy_id": { "type": "string" },
        "signal_id": { "type": "string" },
        "order_id": { "type": "string" },
        "confidence": { "type": "string" },
        "effective_score": { "type": "string" },
        "downside_pct": { "type": "string" },
        "base_upside_pct": { "type": "string" },
        "bear_fair_value": { "type": "string" },
        "bear_return_pct": { "type": "string" },
        "bear_probability_pct": { "type": "string" },
        "base_fair_value": { "type": "string" },
        "base_return_pct": { "type": "string" },
        "base_probability_pct": { "type": "string" },
        "bull_fair_value": { "type": "string" },
        "bull_return_pct": { "type": "string" },
        "bull_probability_pct": { "type": "string" },
        "expected_return_pct": { "type": "string" },
        "confidence_adjusted_expected_return_pct": { "type": "string" },
        "margin_of_safety_pct": { "type": "string" },
        "bear_base_payoff_ratio": { "type": "string" },
        "expected_bear_payoff_ratio": { "type": "string" },
        "buy_below_price": { "type": "string" },
        "canonical_rating": { "enum": ["strong_buy", "buy", "hold", "sell", "strong_sell", "unrated"] },
        "portfolio_action": { "enum": ["initiate", "add", "hold", "trim", "exit", "avoid", "watch", "short_candidate"] },
        "evidence_state": { "type": "string" },
        "rating_change_conditions": { "type": "string" },
        "valuation_horizon_months": { "type": "string" },
        "thesis_summary": { "type": "string" },
        "entry_rule": { "type": "string" },
        "exit_rule": { "type": "string" },
        "invalidation": { "type": "string" },
        "review_at": { "type": "string" },
        "security_research_page": { "type": "string" },
        "strategy_research_page": { "type": "string" },
        "research_page": { "type": "string" },
        "reason_codes": { "$ref": "#/$defs/reasonCodes" }
      }
    },
    "portfolioSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "portfolio_kind", "equity_base", "cash_base", "cash_weight_pct",
        "invested_value_base", "invested_weight_pct", "gross_exposure_base",
        "net_exposure_base", "realized_pnl_base", "unrealized_pnl_base", "rows"
      ],
      "properties": {
        "portfolio_kind": { "enum": ["current", "approved_target", "target"] },
        "equity_base": { "$ref": "#/$defs/decimal" },
        "cash_base": { "$ref": "#/$defs/decimal" },
        "cash_weight_pct": { "$ref": "#/$defs/decimal" },
        "invested_value_base": { "$ref": "#/$defs/decimal" },
        "invested_weight_pct": { "$ref": "#/$defs/decimal" },
        "gross_exposure_base": { "$ref": "#/$defs/decimal" },
        "net_exposure_base": { "$ref": "#/$defs/decimal" },
        "realized_pnl_base": { "$ref": "#/$defs/decimal" },
        "unrealized_pnl_base": { "$ref": "#/$defs/decimal" },
        "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/modelPortfolioRow" } }
      }
    },
    "actionableSignal": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "copy_ready": { "const": true } },
            "required": ["copy_ready"]
          },
          "then": {
            "properties": {
              "order_id": { "type": "string", "minLength": 1 },
              "legs": { "type": "array", "minItems": 1 }
            }
          }
        }
      ],
      "required": [
        "signal_id", "strategy_id", "order_id", "security_id", "ticker", "company_name",
        "action", "action_status", "copy_ready", "quantity", "order_type", "limit_price",
        "currency", "created_at", "expires_at", "market_data_as_of", "current_weight_pct",
        "strategy_name", "entry_rule", "exit_rule", "invalidation",
        "rationale", "research_page", "reason_codes", "legs"
      ],
      "oneOf": [
        {
          "required": ["approved_target_weight_pct"],
          "not": { "required": ["target_weight_pct"] }
        },
        {
          "required": ["target_weight_pct"],
          "not": { "required": ["approved_target_weight_pct"] }
        }
      ],
      "properties": {
        "signal_id": { "type": "string", "minLength": 1 },
        "strategy_id": { "type": "string", "minLength": 1 },
        "allocation_intent_id": { "type": "string" },
        "order_id": { "type": "string" },
        "security_id": { "type": "string", "minLength": 1 },
        "ticker": { "type": "string", "minLength": 1 },
        "company_name": { "type": "string", "minLength": 1 },
        "action": { "enum": ["buy", "add", "hold", "trim", "exit", "no_trade"] },
        "action_status": { "enum": ["pending_order", "active_signal", "awaiting_order_validation"] },
        "copy_ready": { "type": "boolean" },
        "quantity": { "type": "string" },
        "order_type": { "type": "string" },
        "limit_price": { "type": "string" },
        "currency": { "type": "string" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "market_data_as_of": { "$ref": "#/$defs/timestamp" },
        "current_weight_pct": { "$ref": "#/$defs/decimal" },
        "approved_target_weight_pct": { "$ref": "#/$defs/decimal" },
        "target_weight_pct": { "$ref": "#/$defs/decimal" },
        "strategy_name": { "type": "string" },
        "entry_rule": { "type": "string" },
        "exit_rule": { "type": "string" },
        "invalidation": { "type": "string" },
        "rationale": { "type": "string" },
        "security_research_page": { "type": "string" },
        "strategy_research_page": { "type": "string" },
        "research_page": { "type": "string" },
        "reason_codes": { "$ref": "#/$defs/reasonCodes" },
        "legs": { "type": "array", "items": { "$ref": "#/$defs/orderLeg" } }
      }
    },
    "orderLeg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_id", "leg_id", "action", "side", "instrument_type", "security_id",
        "provider_contract_id", "option_type", "expiry", "strike", "quantity",
        "contract_multiplier", "limit_price", "currency"
      ],
      "properties": {
        "order_id": { "type": "string", "minLength": 1 },
        "leg_id": { "type": "string", "minLength": 1 },
        "action": { "enum": ["buy", "sell"] },
        "side": { "enum": ["long", "short"] },
        "instrument_type": { "enum": ["equity", "option"] },
        "security_id": { "type": "string", "minLength": 1 },
        "provider_contract_id": { "type": "string" },
        "option_type": { "type": "string" },
        "expiry": { "type": "string" },
        "strike": { "type": "string" },
        "quantity": { "$ref": "#/$defs/decimal" },
        "contract_multiplier": { "$ref": "#/$defs/decimal" },
        "limit_price": { "type": "string" },
        "currency": { "$ref": "#/$defs/currency" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "security_id", "ticker", "company_name", "research_page", "classification", "rank",
        "effective_score", "candidate_edge", "target_weight_pct", "confidence", "downside_pct",
        "base_upside_pct", "review_at", "reason_codes", "reason_labels"
      ],
      "properties": {
        "security_id": { "type": "string", "minLength": 1 },
        "ticker": { "type": "string", "minLength": 1 },
        "company_name": { "type": "string", "minLength": 1 },
        "research_page": { "type": "string" },
        "classification": { "enum": ["approved", "strategy_ready", "valuation_attractive", "valuation_unattractive", "valuation_unsupported", "liquidity_blocked", "solvency_blocked", "relationship_pending", "strategy_pending", "allocation_constrained", "research_incomplete", "market_data_blocked", "assessment_pending", "risk_blocked", "research_blocked"] },
        "tier": { "enum": ["full", "starter", "watch"] },
        "allocation_intent_id": { "type": "string" },
        "assessment_id": { "type": "string" },
        "valuation_mark": { "type": "string" },
        "valuation_mark_currency": { "type": "string" },
        "valuation_mark_as_of": { "type": "string" },
        "position_cap_pct": { "type": "string" },
        "target_quantity": { "type": "string" },
        "rank": { "type": "string" },
        "effective_score": { "type": "string" },
        "candidate_edge": { "type": "string" },
        "target_weight_pct": { "$ref": "#/$defs/decimal" },
        "confidence": { "type": "string" },
        "downside_pct": { "type": "string" },
        "base_upside_pct": { "type": "string" },
        "review_at": { "type": "string" },
        "reason_codes": { "$ref": "#/$defs/reasonCodes" },
        "reason_labels": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        ,"bear_fair_value": { "type": "string" }
        ,"bear_return_pct": { "type": "string" }
        ,"bear_probability_pct": { "type": "string" }
        ,"base_fair_value": { "type": "string" }
        ,"base_return_pct": { "type": "string" }
        ,"base_probability_pct": { "type": "string" }
        ,"bull_fair_value": { "type": "string" }
        ,"bull_return_pct": { "type": "string" }
        ,"bull_probability_pct": { "type": "string" }
        ,"expected_return_pct": { "type": "string" }
        ,"confidence_adjusted_expected_return_pct": { "type": "string" }
        ,"margin_of_safety_pct": { "type": "string" }
        ,"bear_base_payoff_ratio": { "type": "string" }
        ,"expected_bear_payoff_ratio": { "type": "string" }
        ,"buy_below_price": { "type": "string" }
        ,"canonical_rating": { "enum": ["strong_buy", "buy", "hold", "sell", "strong_sell", "unrated"] }
        ,"portfolio_action": { "enum": ["initiate", "add", "hold", "trim", "exit", "avoid", "watch", "short_candidate"] }
        ,"evidence_state": { "type": "string" }
        ,"eligibility_frontier": { "type": "object", "additionalProperties": { "type": "string" } }
        ,"rating_change_conditions": { "type": "string" }
        ,"research_conclusion": { "type": "string" }
      }
    },
    "researchBenchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "copy_ready", "rows"],
      "oneOf": [
        {
          "required": ["non_approved"],
          "not": { "required": ["comparison_only"] }
        },
        {
          "required": ["comparison_only"],
          "not": { "required": ["non_approved"] }
        }
      ],
      "properties": {
        "policy_version": { "const": "equal_weight_rated_v1" },
        "non_approved": { "const": true },
        "comparison_only": { "const": true },
        "copy_ready": { "const": false },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["security_id", "ticker", "company_name", "rating", "weight_pct", "reference_price", "currency", "research_page"],
            "properties": {
              "security_id": { "type": "string" },
              "ticker": { "type": "string", "minLength": 1 },
              "company_name": { "type": "string", "minLength": 1 },
              "rating": { "enum": ["strong_buy", "buy", "unrated"] },
              "weight_pct": { "$ref": "#/$defs/decimal" },
              "reference_price": { "$ref": "#/$defs/decimal" },
              "currency": { "type": "string" },
              "research_page": { "type": "string" }
            }
          }
        }
      }
    },
    "researchAlert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alert_id", "security_id", "ticker", "company_name", "alert_type", "observed_at", "market_data_date", "research_status", "research_conclusion", "research_page", "visible_label"],
      "properties": {
        "alert_id": { "type": "string", "minLength": 1 },
        "security_id": { "type": "string", "minLength": 1 },
        "ticker": { "type": "string", "minLength": 1 },
        "company_name": { "type": "string", "minLength": 1 },
        "alert_type": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "minLength": 1 },
        "market_data_date": { "type": "string", "minLength": 1 },
        "research_status": { "type": "string", "minLength": 1 },
        "research_conclusion": { "type": "string" },
        "research_page": { "type": "string" },
        "visible_label": { "const": "Research alert — not a trade signal" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allocation_candidate_count", "current_assessment_count", "fresh_evidence_assessment_count", "ready_or_active_strategy_count", "active_signal_count", "pending_order_count", "market_data_success_count", "market_data_failure_count", "research_backlog_count", "blocking_issue_count", "non_blocking_issue_count", "last_successful_daily_run"],
      "properties": {
        "allocation_candidate_count": { "type": "integer", "minimum": 0 },
        "current_assessment_count": { "type": "integer", "minimum": 0 },
        "fresh_evidence_assessment_count": { "type": "integer", "minimum": 0 },
        "current_relationship_count": { "type": "integer", "minimum": 0 },
        "required_relationship_count": { "type": "integer", "minimum": 0 },
        "reviewed_relationship_count": { "type": "integer", "minimum": 0 },
        "accepted_relationship_count": { "type": "integer", "minimum": 0 },
        "required_relationship_review_count": { "type": "integer", "minimum": 0 },
        "ready_or_active_strategy_count": { "type": "integer", "minimum": 0 },
        "active_signal_count": { "type": "integer", "minimum": 0 },
        "pending_order_count": { "type": "integer", "minimum": 0 },
        "market_data_success_count": { "type": "integer", "minimum": 0 },
        "market_data_failure_count": { "type": "integer", "minimum": 0 },
        "research_backlog_count": { "type": "integer", "minimum": 0 },
        "blocking_issue_count": { "type": "integer", "minimum": 0 },
        "non_blocking_issue_count": { "type": "integer", "minimum": 0 },
        "last_successful_daily_run": { "type": "string" }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["daily_return_pct", "cumulative_return_pct", "running_drawdown_pct", "realized_pnl_base", "unrealized_pnl_base", "conviction_exposure_base", "baseline_exposure_base", "largest_position_weight_pct", "largest_sector_weight_pct", "history"],
      "properties": {
        "performance_epoch_id": { "type": "string" },
        "epoch_started_at": { "type": "string" },
        "epoch_opening_equity_base": { "$ref": "#/$defs/decimal" },
        "prior_epoch_count": { "type": "integer", "minimum": 0 },
        "daily_return_pct": { "$ref": "#/$defs/decimal" },
        "cumulative_return_pct": { "$ref": "#/$defs/decimal" },
        "running_drawdown_pct": { "$ref": "#/$defs/decimal" },
        "realized_pnl_base": { "$ref": "#/$defs/decimal" },
        "unrealized_pnl_base": { "$ref": "#/$defs/decimal" },
        "conviction_exposure_base": { "$ref": "#/$defs/decimal" },
        "baseline_exposure_base": { "$ref": "#/$defs/decimal" },
        "largest_position_weight_pct": { "$ref": "#/$defs/decimal" },
        "largest_sector_weight_pct": { "$ref": "#/$defs/decimal" },
        "history": { "type": "array", "items": { "type": "object" } }
      }
    },
    "systemImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_id", "severity", "impact", "title", "summary", "security_id", "ticker", "company_name"],
      "properties": {
        "issue_id": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "minLength": 1 },
        "impact": { "enum": ["blocks_portfolio", "blocks_action", "affects_candidate", "publication_only", "operational_only"] },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "security_id": { "type": "string" },
        "ticker": { "type": "string" },
        "company_name": { "type": "string" }
      }
    }
  }
}
