{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision-driving claim and inspected evidence",
  "type": "object", "additionalProperties": false,
  "required": ["claim_id", "security_ids", "proposition", "state", "kind", "period_start", "period_end", "unit", "currency", "scope", "basis", "assumption_ids", "assessment_ids", "uncertainty", "evidence"],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$"},
    "security_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "proposition": {"type": "string", "minLength": 20, "maxLength": 2000},
    "state": {"enum": ["reported", "supported", "disputed", "uncertain", "hypothesis", "user_note", "superseded"]},
    "kind": {"enum": ["financial", "exposure", "catalyst", "invalidation", "assumption"]},
    "period_start": {"type": ["string", "null"], "format": "date"},
    "period_end": {"type": ["string", "null"], "format": "date"},
    "unit": {"type": "string"}, "currency": {"type": "string", "pattern": "^([A-Z]{3})?$"},
    "scope": {"type": "string", "minLength": 1}, "basis": {"type": "string", "minLength": 1},
    "assumption_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "assessment_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "uncertainty": {"type": "string", "minLength": 1, "maxLength": 2000},
    "evidence": {"type": "array", "maxItems": 30, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["source_history_id", "locator", "excerpt", "role", "rationale", "origin_id", "origin_type", "underlying_observation_id", "published_at", "inspected_at", "inspection_status", "applicability_limit"],
      "properties": {
        "source_history_id": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1}, "excerpt": {"type": "string", "maxLength": 600},
        "role": {"enum": ["supports", "contradicts", "qualifies"]},
        "rationale": {"type": "string", "minLength": 20, "maxLength": 2000},
        "origin_id": {"type": "string", "minLength": 1},
        "origin_type": {"enum": ["issuer", "independent", "unknown", "research_summary"]},
        "underlying_observation_id": {"type": "string", "minLength": 1},
        "published_at": {"type": ["string", "null"], "format": "date-time"},
        "inspected_at": {"type": "string", "format": "date-time"},
        "inspection_status": {"enum": ["observed", "partial", "unavailable"]},
        "applicability_limit": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    }}
  },
  "allOf": [{"if": {"properties": {"kind": {"const": "financial"}}}, "then": {"properties": {
    "period_start": {"type": "string", "format": "date"}, "period_end": {"type": "string", "format": "date"}, "unit": {"type": "string", "minLength": 1}
  }}}]
}
