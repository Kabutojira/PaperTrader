{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Frozen falsifiable research forecast",
  "type": "object", "additionalProperties": false,
  "required": ["forecast_id", "security_id", "event_definition", "horizon_at", "probability", "claim_version_ids", "candidate_disposition", "limitations"],
  "properties": {
    "forecast_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$"},
    "security_id": {"type": "string", "minLength": 1},
    "event_definition": {"type": "string", "minLength": 20, "maxLength": 2000},
    "horizon_at": {"type": "string", "format": "date-time"},
    "probability": {"type": "string", "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"},
    "claim_version_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "candidate_disposition": {"type": "string", "minLength": 1},
    "limitations": {"type": "string", "minLength": 1, "maxLength": 2000}
  }
}
