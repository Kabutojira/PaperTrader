{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papertrader.example/schemas/daily_run.schema.json",
  "title": "PaperTrader deterministic daily run or timestamped cycle manifest",
  "oneOf": [
    { "$ref": "#/$defs/version_1" },
    { "$ref": "#/$defs/version_2" }
  ],
  "$defs": {
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "cycle_id": {
      "type": "string",
      "pattern": "^daily-[0-9]{8}T[0-9]{6}Z$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "timestamp_or_empty": {
      "oneOf": [
        { "const": "" },
        { "type": "string", "format": "date-time", "minLength": 1 }
      ]
    },
    "common_properties": {
      "type": "object",
      "properties": {
        "run_id": { "$ref": "#/$defs/run_id" },
        "trigger": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "$ref": "#/$defs/timestamp_or_empty" },
        "preparation_errors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "uniqueItems": true
        },
        "queue_dispositions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "operation_count": { "type": "integer", "minimum": 0 },
        "model_budget_limit": { "$ref": "#/$defs/decimal" },
        "model_budget_used": { "$ref": "#/$defs/decimal" },
        "fill_outcomes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "report_path": {
          "type": "string",
          "pattern": "^(?:|data/wiki/daily-reports/daily-report_[0-9]{8}\\.md)$"
        },
        "snapshot_id": { "type": "string", "pattern": "^(?:|decision_[0-9a-f]{20})$" },
        "podcast_status": {
          "enum": ["pending", "queued", "succeeded", "skipped", "blocked", "failed"]
        },
        "podcast_operation_id": {
          "type": "string",
          "pattern": "^(?:|[0-9A-HJKMNP-TV-Z]{26})$"
        },
        "podcast_page_path": { "type": "string" },
        "podcast_audio_path": { "type": "string" }
      }
    },
    "version_1": {
      "allOf": [
        { "$ref": "#/$defs/common_properties" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "daily_run_version", "run_id", "trigger", "source_sha", "status", "started_at",
            "completed_at", "preparation_errors", "queue_dispositions", "operation_count",
            "model_budget_limit", "model_budget_used", "fill_outcomes", "report_path"
          ],
          "properties": {
            "daily_run_version": { "const": 1 },
            "run_id": true, "trigger": true, "source_sha": true, "started_at": true,
            "completed_at": true, "preparation_errors": true, "queue_dispositions": true,
            "operation_count": true, "model_budget_limit": true, "model_budget_used": true,
            "fill_outcomes": true, "report_path": true, "snapshot_id": true,
            "status": { "enum": ["prepared", "succeeded", "degraded"] },
            "podcast_status": true, "podcast_operation_id": true,
            "podcast_page_path": {
              "type": "string",
              "pattern": "^(?:|data/wiki/podcasts/daily-podcast_[0-9]{8}\\.md)$"
            },
            "podcast_audio_path": {
              "type": "string",
              "pattern": "^(?:|data/wiki/podcasts/daily-podcast_[0-9]{8}\\.mp3)$"
            }
          }
        }
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id", "terminal_status", "profile", "profile_policy_version", "route_reason",
        "effective_model", "reasoning_effort", "maximum_turns", "weighted_cost",
        "timeout_seconds", "mutation_policy", "auxiliary_models", "escalation_source",
        "checkpoint_index"
      ],
      "properties": {
        "operation_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
        "terminal_status": { "enum": ["succeeded", "skipped", "blocked", "failed"] },
        "profile": { "enum": ["scout", "analyst", "deep"] },
        "profile_policy_version": { "const": "profile-router-v1" },
        "route_reason": { "type": "string", "minLength": 1 },
        "effective_model": { "type": "string", "minLength": 1 },
        "reasoning_effort": { "enum": ["low", "medium", "high"] },
        "maximum_turns": { "type": "integer", "minimum": 1 },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "weighted_cost": { "$ref": "#/$defs/decimal" },
        "mutation_policy": { "enum": ["triage_only", "routine_research", "full_research"] },
        "auxiliary_models": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "escalation_source": { "type": "string" },
        "checkpoint_index": { "type": "integer", "minimum": 0 }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index", "kind", "recorded_at", "operation_id", "operation_type",
        "terminal_status", "profile"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["preparation", "operation", "failure", "finalization", "podcast_text", "credential"] },
        "recorded_at": { "type": "string", "format": "date-time" },
        "operation_id": { "type": "string" },
        "operation_type": { "type": "string" },
        "terminal_status": { "type": "string" },
        "profile": { "type": "string" }
      }
    },
    "version_2": {
      "allOf": [
        { "$ref": "#/$defs/common_properties" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "daily_run_version", "run_id", "daily_cycle_id", "started_at", "operating_date",
            "trigger", "source_sha", "originating_github_run_id", "workflow_attempts", "status",
            "maximum_operations", "remaining_operations", "weighted_model_budget",
            "weighted_model_budget_used", "profile_limits", "operations_attempted",
            "operations_accepted", "checkpoints", "next_checkpoint_index", "preparation_at",
            "research_cutoff_at", "finalization_at", "podcast_text_at", "completion_at",
            "completed_at", "preparation_errors", "queue_dispositions", "operation_count",
            "model_budget_limit", "model_budget_used", "fill_outcomes", "report_path", "snapshot_id",
            "podcast_status", "podcast_operation_id", "podcast_page_path", "podcast_audio_path",
            "final_commit_sha", "finalization_commit_identity", "podcast_commit_identity",
            "final_commit_identity"
          ],
          "properties": {
            "daily_run_version": { "const": 2 },
            "run_id": true, "trigger": true, "source_sha": true, "started_at": true,
            "completed_at": true, "preparation_errors": true, "queue_dispositions": true,
            "operation_count": true, "model_budget_limit": true, "model_budget_used": true,
            "fill_outcomes": true, "report_path": true, "snapshot_id": true,
            "podcast_status": true, "podcast_operation_id": true,
            "daily_cycle_id": { "$ref": "#/$defs/cycle_id" },
            "operating_date": { "type": "string", "format": "date" },
            "originating_github_run_id": { "type": "string", "minLength": 1 },
            "workflow_attempts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["github_run_id", "workflow_attempt", "resumed_at"],
                "properties": {
                  "github_run_id": { "type": "string", "minLength": 1 },
                  "workflow_attempt": { "type": "string", "minLength": 1 },
                  "resumed_at": { "type": "string", "format": "date-time" }
                }
              }
            },
            "status": { "enum": ["running", "interrupted", "degraded", "succeeded", "failed"] },
            "maximum_operations": { "type": "integer", "minimum": 1 },
            "remaining_operations": { "type": "integer", "minimum": 0 },
            "weighted_model_budget": { "$ref": "#/$defs/decimal" },
            "weighted_model_budget_used": { "$ref": "#/$defs/decimal" },
            "profile_limits": {
              "type": "object",
              "required": ["scout", "analyst", "deep"],
              "additionalProperties": false,
              "properties": {
                "scout": { "$ref": "#/$defs/profile_limit" },
                "analyst": { "$ref": "#/$defs/profile_limit" },
                "deep": { "$ref": "#/$defs/profile_limit" }
              }
            },
            "operations_attempted": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" }
            },
            "operations_accepted": { "type": "array", "items": { "$ref": "#/$defs/operation" } },
            "checkpoints": { "type": "array", "items": { "$ref": "#/$defs/checkpoint" } },
            "next_checkpoint_index": { "type": "integer", "minimum": 0 },
            "preparation_at": { "$ref": "#/$defs/timestamp_or_empty" },
            "research_cutoff_at": { "$ref": "#/$defs/timestamp_or_empty" },
            "finalization_at": { "$ref": "#/$defs/timestamp_or_empty" },
            "finalization_status": { "enum": ["succeeded", "degraded"] },
            "podcast_text_at": { "$ref": "#/$defs/timestamp_or_empty" },
            "completion_at": { "$ref": "#/$defs/timestamp_or_empty" },
            "podcast_page_path": {
              "type": "string",
              "pattern": "^(?:|data/wiki/podcasts/daily-podcast_[0-9]{8}T[0-9]{6}Z\\.md)$"
            },
            "podcast_audio_path": { "const": "" },
            "final_commit_sha": { "type": "string", "pattern": "^(?:|[0-9a-f]{40})$" },
            "finalization_commit_identity": {
              "type": "string",
              "pattern": "^(?:|daily-[0-9]{8}T[0-9]{6}Z:checkpoint-[0-9]{3,})$"
            },
            "podcast_commit_identity": {
              "type": "string",
              "pattern": "^(?:|daily-[0-9]{8}T[0-9]{6}Z:checkpoint-[0-9]{3,})$"
            },
            "final_commit_identity": {
              "type": "string",
              "pattern": "^(?:|daily-[0-9]{8}T[0-9]{6}Z:checkpoint-[0-9]{3,})$"
            }
          }
        }
      ]
    },
    "profile_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoning_effort", "maximum_turns", "timeout_seconds", "weighted_cost", "mutation_policy", "policy_version"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "reasoning_effort": { "enum": ["low", "medium", "high"] },
        "maximum_turns": { "type": "integer", "minimum": 1 },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "weighted_cost": { "$ref": "#/$defs/decimal" },
        "mutation_policy": { "enum": ["triage_only", "routine_research", "full_research"] },
        "policy_version": { "const": "profile-router-v1" }
      }
    }
  }
}
