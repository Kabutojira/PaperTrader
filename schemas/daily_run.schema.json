{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papertrader.example/schemas/daily_run.schema.json",
  "title": "PaperTrader deterministic daily run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "daily_run_version",
    "run_id",
    "trigger",
    "source_sha",
    "status",
    "started_at",
    "completed_at",
    "preparation_errors",
    "queue_dispositions",
    "operation_count",
    "model_budget_limit",
    "model_budget_used",
    "fill_outcomes",
    "report_path"
  ],
  "properties": {
    "daily_run_version": { "const": 1 },
    "run_id": { "$ref": "#/$defs/run_id" },
    "trigger": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "status": { "enum": ["prepared", "succeeded", "degraded"] },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": {
      "oneOf": [
        { "const": "" },
        { "type": "string", "format": "date-time", "minLength": 1 }
      ]
    },
    "preparation_errors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 },
      "uniqueItems": true
    },
    "queue_dispositions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "operation_count": { "type": "integer", "minimum": 0 },
    "model_budget_limit": { "$ref": "#/$defs/decimal" },
    "model_budget_used": { "$ref": "#/$defs/decimal" },
    "fill_outcomes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "report_path": {
      "type": "string",
      "pattern": "^(?:|data/wiki/daily-reports/daily-report_[0-9]{8}\\.md)$"
    }
  },
  "$defs": {
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    }
  }
}
