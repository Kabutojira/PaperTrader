{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned canonical research scope",
  "type": "object", "additionalProperties": false,
  "required": ["topic_id", "entity_type", "entity_id", "scope_class", "anchor_ids", "parent_ids", "contributions", "lifecycle", "reason", "summary", "evidence_refs", "reactivation_conditions", "user_request_ref", "review_at"],
  "properties": {
    "topic_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$"},
    "entity_type": {"enum": ["security", "idea", "concept", "relationship"]},
    "entity_id": {"type": "string", "minLength": 1},
    "scope_class": {"enum": ["user_directed", "directly_adjacent", "peripheral", "legacy_unclassified"]},
    "anchor_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "parent_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "contributions": {"type": "array", "maxItems": 20, "items": {
      "type": "object", "additionalProperties": false, "required": ["anchor_id", "mechanism", "evidence_refs"],
      "properties": {"anchor_id": {"type": "string"}, "mechanism": {"type": "string", "minLength": 20},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
    }},
    "lifecycle": {"enum": ["active", "archived", "deferred"]},
    "reason": {"enum": ["explicit_tracking", "direct_contribution", "bounded_exploration", "legacy_unclassified", "no_material_exposure", "unsupported_thesis", "invalidated_thesis", "unattractive_valuation", "catalyst_expired", "deferred_for_capacity"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reactivation_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "user_request_ref": {"type": "string"},
    "review_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
