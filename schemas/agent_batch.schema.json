{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papertrader.example/schemas/agent_batch.schema.json",
  "title": "PaperTrader sequential agent batch result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_batch_version",
    "run_id",
    "started_at",
    "completed_at",
    "maximum_operations",
    "maximum_model_budget",
    "estimated_cost_per_operation",
    "operation_count",
    "estimated_model_budget_used",
    "outcomes"
  ],
  "properties": {
    "agent_batch_version": { "const": 1 },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "maximum_operations": { "type": "integer", "minimum": 0 },
    "maximum_model_budget": { "$ref": "#/$defs/decimal" },
    "estimated_cost_per_operation": { "$ref": "#/$defs/decimal" },
    "operation_count": { "type": "integer", "minimum": 0 },
    "estimated_model_budget_used": { "$ref": "#/$defs/decimal" },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation_id", "status"],
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "status": {
            "enum": ["succeeded", "skipped", "blocked", "failed"]
          }
        }
      }
    }
  },
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    }
  }
}
