{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://papertrader.example/schemas/operation_payload.schema.json",
  "title": "PaperTrader operation payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload_version",
    "operation_id",
    "operation_type",
    "entity_type",
    "entity_id",
    "objective",
    "inputs"
  ],
  "properties": {
    "payload_version": { "const": 1 },
    "operation_id": { "$ref": "#/$defs/ulid" },
    "operation_type": {
      "type": "string",
      "enum": [
        "wiki_ingest",
        "source_discovery",
        "opportunity_research",
        "quick_check_research",
        "idea_research",
        "security_research",
        "relationship_research",
        "strategy_research",
        "execute_strategy",
        "daily_podcast"
      ]
    },
    "entity_type": {
      "type": "string",
      "enum": ["source", "opportunity", "idea", "security", "relationship", "strategy", "run"]
    },
    "entity_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "inputs": { "type": "object" },
    "source_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "operation_type": { "const": "daily_podcast" },
            "inputs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "run_id",
                "context_path",
                "report_path",
                "page_path",
                "target_minutes",
                "target_words"
              ],
              "properties": {
                "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
                "context_path": { "$ref": "#/$defs/repository_path" },
                "report_path": { "$ref": "#/$defs/repository_path" },
                "page_path": { "type": "string", "pattern": "^data/wiki/podcasts/daily-podcast_[0-9]{8}T[0-9]{6}Z\\.md$" },
                "target_minutes": { "const": 20 },
                "target_words": { "type": "integer", "minimum": 2800, "maximum": 3200 }
              }
            }
          }
        },
        {
          "properties": {
            "operation_type": { "const": "wiki_ingest" },
            "inputs": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["source_path", "source_hash"],
                  "properties": {
                    "source_path": { "$ref": "#/$defs/repository_path" },
                    "source_hash": { "$ref": "#/$defs/sha256" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source_kind",
                    "source_id",
                    "video_id",
                    "video_title",
                    "video_url",
                    "channel_id",
                    "channel_handle",
                    "channel_url",
                    "discovered_at",
                    "transcript_languages",
                    "prefer_human",
                    "discovery_mode"
                  ],
                  "properties": {
                    "source_kind": { "const": "youtube_video" },
                    "source_id": {
                      "type": "string",
                      "pattern": "^youtube_[A-Za-z0-9_-]{11}$"
                    },
                    "video_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{11}$"
                    },
                    "video_title": { "type": "string", "maxLength": 500 },
                    "video_url": {
                      "type": "string",
                      "pattern": "^https://www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}$"
                    },
                    "channel_id": {
                      "type": "string",
                      "pattern": "^UC[A-Za-z0-9_-]{22}$"
                    },
                    "channel_handle": {
                      "type": "string",
                      "pattern": "^@[A-Za-z0-9._-]{3,64}$"
                    },
                    "channel_url": {
                      "type": "string",
                      "pattern": "^https://www\\.youtube\\.com/channel/UC[A-Za-z0-9_-]{22}/videos$"
                    },
                    "discovered_at": { "type": "string", "format": "date-time" },
                    "transcript_languages": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
                      }
                    },
                    "prefer_human": { "type": "boolean" },
                    "discovery_mode": { "enum": ["bootstrap", "incremental", "backfill"] }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source_kind",
                    "source_id",
                    "content_kind",
                    "article_id",
                    "title",
                    "canonical_url",
                    "discovered_at",
                    "discovery_operation_id",
                    "discovery_date",
                    "rank",
                    "summary_hash",
                    "metadata_hash",
                    "related_entity_ids",
                    "lead_reason",
                    "discovery_mode",
                    "direct_site_access_allowed"
                  ],
                  "properties": {
                    "source_kind": { "const": "seekingalpha_search_lead" },
                    "source_id": {
                      "type": "string",
                      "pattern": "^seekingalpha_(?:analysis|news)_[1-9][0-9]*$"
                    },
                    "content_kind": { "enum": ["analysis", "news"] },
                    "article_id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
                    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
                    "canonical_url": {
                      "type": "string",
                      "pattern": "^https://seekingalpha\\.com/(?:article|news)/[1-9][0-9]*(?:-[a-z0-9]+(?:-[a-z0-9]+)*)?$"
                    },
                    "author": { "type": "string", "maxLength": 200 },
                    "published_at": {
                      "oneOf": [
                        { "const": "" },
                        { "type": "string", "format": "date-time" }
                      ]
                    },
                    "discovered_at": { "type": "string", "format": "date-time" },
                    "discovery_operation_id": { "$ref": "#/$defs/ulid" },
                    "discovery_date": { "type": "string", "format": "date" },
                    "rank": { "type": "integer", "minimum": 1 },
                    "summary_hash": { "$ref": "#/$defs/sha256" },
                    "metadata_hash": { "$ref": "#/$defs/sha256" },
                    "related_entity_ids": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
                    },
                    "lead_reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
                    "discovery_mode": { "const": "search_index" },
                    "direct_site_access_allowed": { "const": false }
                  }
                }
              ]
            }
          }
        },
        {
          "properties": {
            "operation_type": { "const": "source_discovery" },
            "inputs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_kind",
                "source_id",
                "discovery_date",
                "analysis_page_url",
                "news_page_url",
                "analysis_candidate_limit",
                "news_candidate_limit",
                "lookback_days",
                "search_attempts",
                "maximum_leads",
                "discovery_mode",
                "direct_site_access_allowed"
              ],
              "properties": {
                "source_kind": { "const": "seekingalpha_search_index" },
                "source_id": { "const": "seekingalpha_trending_daily" },
                "discovery_date": { "type": "string", "format": "date" },
                "analysis_page_url": {
                  "const": "https://seekingalpha.com/trending-analysis"
                },
                "news_page_url": {
                  "const": "https://seekingalpha.com/market-news/trending"
                },
                "analysis_candidate_limit": { "type": "integer", "minimum": 1 },
                "news_candidate_limit": { "type": "integer", "minimum": 1 },
                "lookback_days": { "type": "integer", "minimum": 1, "maximum": 7 },
                "search_attempts": { "const": 3 },
                "maximum_leads": { "type": "integer", "minimum": 1, "maximum": 5 },
                "discovery_mode": { "const": "search_index" },
                "direct_site_access_allowed": { "const": false }
              }
            }
          }
        },
        {
          "properties": {
            "operation_type": { "const": "opportunity_research" },
            "inputs": {
              "type": "object",
              "required": [
                "security_id",
                "trigger_type",
                "market_data_as_of",
                "period_start",
                "period_end"
              ],
              "properties": {
                "security_id": { "type": "string", "minLength": 1 },
                "trigger_type": { "type": "string", "minLength": 1 },
                "market_data_as_of": { "type": "string", "format": "date-time" },
                "period_start": { "type": "string", "format": "date" },
                "period_end": { "type": "string", "format": "date" }
              }
            }
          }
        },
        {
          "properties": {
            "operation_type": { "const": "quick_check_research" },
            "inputs": {
              "type": "object",
              "required": [
                "security_id",
                "baseline_operation_id",
                "baseline_result_path",
                "baseline_completed_at",
                "trigger_types",
                "market_data_as_of",
                "market_data_date",
                "period_start",
                "period_end",
                "source_price_hash"
              ],
              "properties": {
                "security_id": { "type": "string", "minLength": 1 },
                "baseline_operation_id": { "$ref": "#/$defs/ulid" },
                "baseline_result_path": { "$ref": "#/$defs/repository_path" },
                "baseline_completed_at": { "type": "string", "format": "date-time" },
                "trigger_types": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "market_data_as_of": { "type": "string", "format": "date-time" },
                "market_data_date": { "type": "string", "format": "date" },
                "period_start": { "type": "string", "format": "date" },
                "period_end": { "type": "string", "format": "date" },
                "source_price_hash": { "$ref": "#/$defs/sha256" },
                "research_reasons": { "type": "array", "items": { "type": "object" } },
                "merged_input_values": { "type": "object" },
                "full_research_requested": { "type": "boolean" }
              }
            }
          }
        },
        {
          "properties": {
            "operation_type": { "const": "idea_research" },
            "inputs": {
              "type": "object",
              "required": ["idea_id", "seed_claim"],
              "properties": {
                "idea_id": { "type": "string", "minLength": 1 },
                "seed_claim": { "type": "string", "minLength": 1 },
                "security_id": { "type": "string", "minLength": 1 },
                "security_research_operation_id": { "$ref": "#/$defs/ulid" },
                "security_research_result_path": { "$ref": "#/$defs/repository_path" }
              },
              "allOf": [
                {
                  "if": { "required": ["security_research_operation_id"] },
                  "then": {
                    "required": [
                      "security_id", "security_research_result_path"
                    ]
                  }
                }
              ]
            }
          }
        },
        {
          "properties": {
            "operation_type": { "const": "security_research" },
            "inputs": {
              "type": "object",
              "required": ["security_id"],
              "properties": {
                "security_id": { "type": "string", "minLength": 1 },
                "idea_id": { "type": "string", "minLength": 1 },
                "idea_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "trigger_types": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "minLength": 1 }
                },
                "market_data_as_of": { "type": "string", "format": "date-time" },
                "market_data_date": { "type": "string", "format": "date" },
                "period_start": { "type": "string", "format": "date" },
                "period_end": { "type": "string", "format": "date" },
                "source_price_hash": { "$ref": "#/$defs/sha256" }
              },
              "allOf": [
                {
                  "if": { "required": ["trigger_types"] },
                  "then": {
                    "required": [
                      "market_data_as_of", "market_data_date", "period_start", "period_end",
                      "source_price_hash"
                    ]
                  }
                }
              ]
            }
          }
        },
        {
          "properties": {
            "operation_type": { "const": "relationship_research" },
            "inputs": {
              "type": "object",
              "required": ["relationship_id", "idea_id", "security_id"],
              "properties": {
                "relationship_id": { "type": "string", "minLength": 1 },
                "idea_id": { "type": "string", "minLength": 1 },
                "security_id": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        {
          "properties": {
            "operation_type": { "const": "strategy_research" },
            "inputs": {
              "type": "object",
              "required": ["strategy_id", "relationship_id"],
              "properties": {
                "strategy_id": { "type": "string", "minLength": 1 },
                "relationship_id": { "type": "string", "minLength": 1 },
                "mode": { "type": "string", "enum": ["conviction", "baseline_allocation"] },
                "allocation_plan_id": { "type": "string", "minLength": 1 },
                "security_id": { "type": "string", "minLength": 1 },
                "current_weight_pct": { "$ref": "#/$defs/decimal_text" },
                "target_weight_pct": { "$ref": "#/$defs/decimal_text" },
                "maximum_weight_pct": { "$ref": "#/$defs/decimal_text" },
                "selection_rank": { "type": "integer", "minimum": 0 },
                "effective_score": { "$ref": "#/$defs/decimal_text" },
                "assessment_as_of": { "type": "string", "format": "date-time" },
                "disposition": {
                  "type": "string",
                  "enum": ["open", "increase", "reduce", "close"]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": { "mode": { "const": "baseline_allocation" } },
                    "required": ["mode"]
                  },
                  "then": {
                    "required": [
                      "allocation_plan_id",
                      "security_id",
                      "current_weight_pct",
                      "target_weight_pct",
                      "maximum_weight_pct",
                      "selection_rank",
                      "effective_score",
                      "assessment_as_of",
                      "disposition"
                    ]
                  }
                }
              ]
            }
          }
        },
        {
          "properties": {
            "operation_type": { "const": "execute_strategy" },
            "inputs": {
              "type": "object",
              "required": ["strategy_id", "signal_id", "action"],
              "properties": {
                "strategy_id": { "type": "string", "minLength": 1 },
                "signal_id": { "type": "string", "minLength": 1 },
                "action": {
                  "type": "string",
                  "enum": ["open", "reduce", "close", "roll", "cancel", "hold"],
                  "description": "For baseline allocations, open also represents increase."
                }
              }
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "decimal_text": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    }
  }
}
