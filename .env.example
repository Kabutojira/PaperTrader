# Use an absolute path in automation. This relative form is convenient locally.
WIKI_PATH=./data/wiki

# Runtime secrets are intentionally absent. Non-dry GitHub runs restore OpenAI Codex OAuth from
# the repository's age ciphertext using OPENAI_OAUTH_SECRET, which remains in GitHub Secrets.
# Never place the age identity, plaintext auth.json, GitHub write, Telegram, deployment, or
# brokerage credentials in this file.

# Maximum queued research iterations in one daily cycle. The repository hard ceiling still applies.
MAX_OPERATIONS=20

# Optional profile-specific turn overrides. Prefer the repository defaults unless benchmarking.
# HERMES_SCOUT_MAX_TURNS=32
# HERMES_ANALYST_MAX_TURNS=80
# HERMES_DEEP_MAX_TURNS=160

# Hermes auxiliary Web ExtractPage summarizer, encoded as provider:model.
AUXILIARY_MODEL=openai-codex:gpt-5.6-terra

# Optional YouTube Data API key. When empty, curated discovery uses anonymous pytubefix.
YOUTUBE_DATA_API=

# Required only when AUXILIARY_MODEL selects the openrouter provider. Export secrets from a local
# ignored .env file or the invoking shell; never save them in the managed Hermes profile.
OPENROUTER_API_KEY=
