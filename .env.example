# Use an absolute path in automation. This relative form is convenient locally.
WIKI_PATH=./data/wiki

# Runtime secrets are intentionally absent. Non-dry GitHub runs restore OpenAI Codex OAuth from
# the repository's age ciphertext using OPENAI_OAUTH_SECRET, which remains in GitHub Secrets.
# Never place the age identity, plaintext auth.json, GitHub write, Telegram, deployment, or
# brokerage credentials in this file.

# Local non-dry Hermes runs require this only for public Web ExtractPage summarization. Export it
# in the invoking shell; do not save a value in this repository or the managed Hermes profile.
OPENROUTER_API_KEY=
