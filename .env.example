# PaperTrader refuses to start unless this is explicitly true.
PAPER_TRADING_ONLY=true

# Use an absolute path in automation. This relative form is convenient locally.
WIKI_PATH=./data/wiki

# Runtime secrets are intentionally absent. Hermes must never receive GitHub write,
# Telegram, deployment, or brokerage credentials.
# Supply an inference-only provider credential (for example OPENROUTER_API_KEY) from the parent
# process or GitHub secret store; never commit it or place it in the managed Hermes profile.
